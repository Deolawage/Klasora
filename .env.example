SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
# Set to the deployed origin in production; localhost is for local development.
APP_URL=http://localhost:3000
# Set on Vercel to the public Railway backend origin when using a separate chat/API server.
# Leave empty on Railway and for a single-host deployment.
PUBLIC_BACKEND_URL=
# Replace with a private, cryptographically random value of at least 32 characters.
JWT_SECRET=replace_with_a_private_random_secret_at_least_32_characters
PORT=3000

# AI Study Assistant - Get a key at https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Optional model override
# GROQ_MODEL=openai/gpt-oss-20b

# Push Notifications - generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:you@example.com
